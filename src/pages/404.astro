---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="That page doesn't exist.">
  <section class="wrap py-28 text-center">
    <p class="label label--signal">Error 404</p>
    <h1 class="mt-5">This one didn't land.</h1>
    <p class="mx-auto mt-5 max-w-md text-lg">The page you were looking for isn't here. Try the curriculum or head back to the start.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn--primary">Back to home</a>
      <a href="/program" class="btn btn--ghost">See the curriculum</a>
    </div>
  </section>
</Base>
