---
import { nav } from "../data/site";
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur-sm">
  <div class="wrap flex flex-col items-start gap-1 py-2.5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-3.5">
    <a href="/" class="group flex items-center gap-2.5 no-underline">
      <img
        src="/images/stem-science-for-all-logo.png"
        alt=""
        aria-hidden="true"
        width="40"
        height="40"
        class="h-10 w-10 shrink-0 rounded-full object-cover"
      />
      <span class="display text-[0.95rem] uppercase" style="font-stretch:104%">
        STEM &amp; Science<span class="text-signal"> for All</span>
      </span>
    </a>
    <nav aria-label="Main" class="-ml-2.5 flex items-center gap-1 sm:ml-0 sm:gap-2">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? "page" : undefined}
          class:list={[
            "label px-2.5 py-2 no-underline transition-colors hover:text-ink",
            path === item.href && "text-ink underline decoration-signal decoration-2 underline-offset-[6px]",
          ]}
        >{item.label}</a>
      ))}
      <a href="/join" class="btn btn--primary ml-2 hidden !px-4 !py-2.5 sm:inline-flex">Register</a>
    </nav>
  </div>
</header>
